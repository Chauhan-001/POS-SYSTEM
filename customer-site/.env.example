# Base URL of the shared backend API.
# Dev: leave as the default http://localhost:3001/api
# Prod (same-origin, recommended): VITE_API_URL=/api
VITE_API_URL=http://localhost:3001/api

# Socket.IO server URL.
# Leave blank for dev (defaults to http://localhost:3001).
# For a same-origin prod build set VITE_SOCKET_URL=/ (or blank when VITE_API_URL=/api).
# VITE_SOCKET_URL=