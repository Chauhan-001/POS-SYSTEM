# ═══════════════════════════════════════════════════════════════
#  POS TERMINAL — Environment Configuration
#  Copy this file to `.env` (in this Frontend/ directory — Vite loads
#  .env from the app root) and fill in real values.
#  Only VITE_ prefixed keys are exposed to the browser.
# ═══════════════════════════════════════════════════════════════

# POS Backend API base URL (used when the /api Vite proxy is not active)
VITE_API_URL=http://localhost:3002
