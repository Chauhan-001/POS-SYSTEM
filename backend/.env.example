# ═══════════════════════════════════════════════════════════════
#  POS BACKEND — Environment Configuration
#  Copy this file to `.env` and fill in real values.
#  All keys are read at runtime via dotenv (src/config.ts).
# ═══════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
# Comma-separated list of allowed admin origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173,http://localhost:5175
ADMIN_CORS_ORIGINS=http://localhost:5174

# ─── MongoDB ───────────────────────────────────────────────────
# MONGODB_URI=mongodb://localhost:27017/pos

# ─── JWT (development only — use strong secrets in production) ──
JWT_SECRET=change-me-in-production
REFRESH_SECRET=change-me-in-production
JWT_ISSUER=restaurant-pos

# ─── Redis (optional; falls back to in-memory when empty) ───────
# REDIS_URL=redis://localhost:6379

# ─── AI Configuration (OpenAI-compatible endpoint, e.g. Groq) ──
AI_PROVIDER=openai
AI_API_KEY=
# Optional fallback keys (extra Groq/OpenAI-compatible accounts). The LLM
# provider auto-retries each fallback in order if the primary fails — including
# on 429 rate limits, which park the exhausted key for 60s so the chain cycles.
# NOTE: STT (voice) always uses the PRIMARY key (AI_API_KEY), not these.
# AI_API_KEY_FALLBACKS=key1,key2,key3
# AI_API_KEY_FALLBACK= (legacy single fallback, still honoured)
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15000
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3

# ─── Speech-to-Text (voice recording) — separate from the LLM ──
# STT_PROVIDER=openai
STT_PROVIDER=
STT_MODEL=

# ─── Speech-to-Text — Production Provider Chain ─────────────────
# Deepgram Flux (PRIMARY). This is the current production setup — no Google
# key required. The chain auto-detects Deepgram as the first provider when
# DEEPGRAM_API_KEY is set.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
DEEPGRAM_SMART_FORMAT=

# Google Cloud STT (optional FALLBACK — only used when Deepgram is unset or
# failing AND a Google key is present). Use either:
#   - GOOGLE_API_KEY: a simple API-key-restricted Google Cloud key with
#     "Cloud Speech-to-Text API" enabled, OR
#   - STT_API_KEY: the legacy alias (same key value).
# When both are unset, Google is skipped entirely.
GOOGLE_API_KEY=
STT_API_KEY=

# Provider tuning (optional):
GOOGLE_STT_MODEL=latest_short
GOOGLE_STT_LOCATION=
# Voice Action confirmation window (ms). Default 5 minutes.
VOICE_CONFIRM_TTL_MS=300000

# ─── Voice API audio caps + per-tenant rate limiting ───────────
# Max decoded audio bytes (~3 MB) and max estimated duration for one
# transcribe payload. Oversized clips are rejected with HTTP 413.
# VOICE_MAX_AUDIO_BYTES=3145728
# VOICE_MAX_DURATION_SEC=30
# Per-restaurant voice rate limit (parse/transcribe/confirm/converse).
RL_VOICE_WINDOW_MS=60000
RL_VOICE_MAX=90

# ─── STT cost estimation (USD per minute, price-per-usage) ─────
# Used to estimate per-call cost for the STT usage ledger.
STT_COST_PER_MIN_GOOGLE=0.024
STT_COST_PER_MIN_DEEPGRAM=0.004
STT_COST_PER_MIN_GROQ=0.001

# ─── Weather (dashboard weather widget) ────────────────────────
# WEATHER_API_KEY=

# ─── Razorpay Payment Gateway (Test Mode) ──────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Subscriptions ─────────────────────────────────────────────
TRIAL_DAYS=7

# ─── Uploads ───────────────────────────────────────────────────
# UPLOADS_DIR=uploads

# ─── Frontend static build (served at / in production) ──────────
# Absolute path to the built POS frontend. Defaults to the monorepo layout
# <repo>/restaurant-pos/Frontend/dist — override only when hosting elsewhere.
# FRONTEND_DIST=C:/path/to/Frontend/dist
