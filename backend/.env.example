# ═══════════════════════════════════════════════════════════════
#  POS BACKEND — Environment Configuration
#  Copy this file to `.env` and fill in real values.
#  All keys are read at runtime via dotenv (src/config.ts).
# ═══════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
# Comma-separated list of allowed admin origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173,http://localhost:5175
ADMIN_CORS_ORIGINS=http://localhost:5174

# ─── MongoDB ───────────────────────────────────────────────────
# MONGODB_URI=mongodb://localhost:27017/pos

# ─── JWT (development only — use strong secrets in production) ──
JWT_SECRET=change-me-in-production
REFRESH_SECRET=change-me-in-production
JWT_ISSUER=restaurant-pos

# ─── Redis (optional; falls back to in-memory when empty) ───────
# REDIS_URL=redis://localhost:6379

# ─── AI Configuration (OpenAI-compatible endpoint, e.g. Groq) ──
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15000
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3

# ─── Speech-to-Text (voice recording) — separate from the LLM ──
# STT_PROVIDER=openai
STT_PROVIDER=
STT_MODEL=

# ─── Weather (dashboard weather widget) ────────────────────────
# WEATHER_API_KEY=

# ─── Razorpay Payment Gateway (Test Mode) ──────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Subscriptions ─────────────────────────────────────────────
TRIAL_DAYS=7

# ─── Uploads ───────────────────────────────────────────────────
# UPLOADS_DIR=uploads
