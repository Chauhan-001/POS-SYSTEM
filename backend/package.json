{
  "name": "pos-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:fact-consistency": "npx tsx scripts/audit-fact-consistency.ts",
    "audit:fact-consistency:live": "npx tsx scripts/audit-fact-consistency.ts --live",
    "audit:security": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit",
    "seed:demo": "npx tsx scripts/seed-demo.ts",
    "seed:demo:reset": "npx tsx scripts/seed-demo.ts --reset",
    "seed:demo:clean": "npx tsx scripts/seed-demo.ts --clean",
    "seed:demo:report": "npx tsx scripts/seed-demo.ts --report",
    "backup": "bash scripts/mongodb-backup.sh",
    "backup:drill": "bash scripts/mongodb-restore-drill.sh"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cron": "^3.5.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/cron": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}