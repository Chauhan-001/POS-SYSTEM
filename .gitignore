# ═══════════════════════════════════════════════════════════════
#  ROOT .gitignore — repo-wide ignores
#  Each service also has its own .gitignore (backend/,
#  admin-dashboard/, restaurant-pos/).
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies (untracked from the index) ───────────────────
node_modules/
**/node_modules/

# ─── OS / editor ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# ─── Agent tool runtime state ───────────────────────────────────
.freebuff/

# ─── One-off scripts / data backups ─────────────────────────────
backend/scripts/*backup*/
backend/scripts/*backup*.json

# ─── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Build outputs / generated ──────────────────────────────────
dist/
dist-electron/
build/
release/
coverage/
.nyc_output/
test-results/
playwright-report*/
*.tsbuildinfo

# ─── Env / secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example
